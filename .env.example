# Email-bot backend ka base URL (bina trailing slash).
# Ye set hote hi portfolio ka sara content API se live aayega,
# contact form leads, visit logs, chat sessions aur resume download bhi chalu.
# Example (local): http://localhost:5000
# Example (production): https://email-bot-xxxx.onrender.com
VITE_API_URL=http://localhost:5000

# Encrypted API token: MUST match PORTFOLIO_API_KEY in email-bot's .env.
# Every portfolio API call sends an AES-256-GCM sealed timestamp in the
# X-Portfolio-Token header; the backend decrypts and rejects forged/stale
# tokens. Keep this secret — never commit the real .env file.
VITE_PORTFOLIO_API_KEY=paste-the-same-value-as-email-bot-PORTFOLIO_API_KEY

# Legacy fallback (optional): Formspree / Web3Forms endpoint
# VITE_CONTACT_ENDPOINT=https://formspree.io/f/xxxx
